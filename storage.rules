rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product photos: publicly readable (payment links/product cards show
    // them to anonymous buyers), but a merchant may only write into their
    // own folder, and only small image files.
    match /products/{merchantId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == merchantId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == merchantId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
