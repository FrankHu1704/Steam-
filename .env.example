# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SMSMoz
# Secret used to sign internal JWTs / verify webhook signatures
APP_SECRET=change-me-to-a-long-random-string

# ── SMS Gateway (provider abstraction, see src/lib/sms/provider.ts) ───────
SMS_PROVIDER=mock
SMS_GATEWAY_API_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=SMSMoz

# ── M-Pesa (Vodacom Moçambique) ─────────────────────────────────────────
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ENV=sandbox

# ── e-Mola ───────────────────────────────────────────────────────────────
EMOLA_API_KEY=
EMOLA_MERCHANT_ID=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── PayPal ───────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ── Rate limiting (optional Upstash Redis; falls back to in-memory) ───────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
