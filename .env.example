# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Debito Pay (payment-orchestrator) — platform aggregator credentials.
DEBITO_PAY_API_KEY=
DEBITO_PAY_WEBHOOK_SECRET=
DEBITO_PAY_MERCHANT_ID=
DEBITO_PAY_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1
# Each Debito Pay wallet is bound to one payment method — see README.
DEBITO_PAY_WALLET_CODE_MPESA=
DEBITO_PAY_WALLET_CODE_EMOLA=
DEBITO_PAY_WALLET_CODE_MKESH=
DEBITO_PAY_WALLET_CODE_VISA_MASTERCARD=
DEBITO_PAY_WALLET_CODE_PAYFAST=

# ZumboPay (payment processor) — second option, switchable in
# Dashboard admin -> Definições -> "Processador de pagamento activo".
ZUMBOPAY_API_KEY=
ZUMBOPAY_MERCHANT_ID=
ZUMBOPAY_WEBHOOK_SECRET=
ZUMBOPAY_API_URL=https://zumbopay.com/api/public/v1
# wallet_id (6-digit code) per method — from ZumboPay -> Carteiras.
ZUMBOPAY_WALLET_MPESA=
ZUMBOPAY_WALLET_EMOLA=
ZUMBOPAY_WALLET_CARD=

# NetShop (payment processor) — third option, switchable in
# Dashboard admin -> Definições -> "Processador de pagamento activo".
# The only one of the three whose B2C payout supports e-Mola as well as M-Pesa.
NETSHOP_API_KEY=
# NetShop creates a SEPARATE wallet per payment method (Negócio → Carteiras
# in their dashboard), each with its own 6-digit id — not one blanket
# merchant id. Set the one matching each method you accept.
NETSHOP_WALLET_MPESA=
NETSHOP_WALLET_EMOLA=
NETSHOP_WALLET_MKESH=
NETSHOP_WALLET_CARD=
NETSHOP_WEBHOOK_SECRET=
NETSHOP_API_URL=https://www.netshop.co.mz/api/v1

# Pagar (payment processor, pagar.co.mz) — fourth option, switchable in
# Dashboard admin -> Definições -> "Processador de pagamento activo".
# PAGAR_API_KEY / PAGAR_SIGNING_SECRET from Painel -> Integração -> API key.
# PAGAR_WEBHOOK_SECRET from Painel -> Integração -> Webhook (shown once).
PAGAR_API_KEY=
PAGAR_SIGNING_SECRET=
PAGAR_WEBHOOK_SECRET=
PAGAR_API_URL=

# PaySuite (payment processor, paysuite.tech) — e-Mola-only charge
# processor, selectable in Dashboard admin -> Definições -> "e-Mola
# processado via". No B2C payout support (not documented by PaySuite yet),
# so it can't be used for withdrawals. PAYSUITE_API_TOKEN from the merchant
# dashboard under Settings > API Access. PAYSUITE_WEBHOOK_URL is optional —
# set it to override the account-level webhook URL configured in PaySuite's
# merchant settings.
PAYSUITE_API_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
PAYSUITE_API_URL=
PAYSUITE_WEBHOOK_URL=

# Public site URL (used for return_url / links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional emails: sale notifications, product approvals) — free tier
RESEND_API_KEY=
RESEND_FROM_EMAIL=PagaJá <onboarding@resend.dev>
# Replies to any PagaJá email land here (can't send FROM a personal Gmail/Outlook
# address without owning its domain — this is the practical equivalent).
RESEND_REPLY_TO_EMAIL=

# Tsemba (WhatsApp gateway) — sends a WhatsApp receipt with the download
# link to the buyer, and drives abandoned-cart nudges.
TSEMBA_API_KEY=
TSEMBA_API_URL=https://hdxqelinqivwgmggolhs.supabase.co/functions/v1/api-gateway
# Optional — WhatsApp instance name registered in the Tsemba panel; omit to use "TSEMBA".
TSEMBA_WHATSAPP_INSTANCE=

# Easyhost (bulk SMS API) — sends "pagamento confirmado" to the producer
# and "compra confirmada" to the buyer on every paid order.
EASYHOST_API_KEY=
EASYHOST_API_URL=https://iiywyqfapgqkggvxyvfd.supabase.co/functions/v1/api
# Optional — approved Sender ID (max 11 chars); omit to use the account default.
EASYHOST_SENDER_ID=

# Web push notifications (Dashboard -> Definições -> Notificações Push).
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service can reach you at (mailto: or https:).
VAPID_SUBJECT=mailto:suporte@pagaja.vercel.app

# LunaAI (Dashboard -> Produtos -> Editar) — product analysis feature,
# branded to producers as PagaJá's own AI. Runs on Groq under the hood
# (never expose that name in user-facing text). Free tier at console.groq.com/keys.
# Prefer GROQ_API_KEYS (comma-separated) to spread load and fail over
# automatically if one key hits a rate limit; GROQ_API_KEY (single) still
# works if that's all you have.
GROQ_API_KEYS=
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# Secures /api/cron/employee-payouts (day-1-of-month collaborator payout).
# Vercel automatically sends this as a Bearer token when calling its own
# Cron Jobs if this env var is set — generate any random string.
CRON_SECRET=
