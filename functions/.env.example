# Non-secret Debito Pay config, loaded by firebase-functions v2 defineString().
# Copy this file to `.env` (gitignored) and fill in your real values —
# `functions/.env` is only used locally / at deploy time to bake these in.
DEBITO_PAY_MERCHANT_ID=
DEBITO_PAY_WALLET_CODE=
# Optional override, defaults to the Debito Pay production Supabase URL.
# DEBITO_PAY_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1

# Secrets (DEBITO_PAY_API_KEY, DEBITO_PAY_WEBHOOK_SECRET, ADMIN_BOOTSTRAP_SECRET)
# are NOT set here — they go through Cloud Secret Manager instead:
#   firebase functions:secrets:set DEBITO_PAY_API_KEY
#   firebase functions:secrets:set DEBITO_PAY_WEBHOOK_SECRET
#   firebase functions:secrets:set ADMIN_BOOTSTRAP_SECRET
