rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(merchantId) {
      return isSignedIn() && request.auth.uid == merchantId;
    }

    // users/{uid} mirrors the role custom claim for easy client reads.
    // Only the server (Cloud Functions, via admin SDK) may write it.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // merchants/{uid}: profile + ledger balances. Merchants can read their
    // own doc; balances are only ever mutated server-side (Cloud Functions),
    // never by direct client writes.
    match /merchants/{merchantId} {
      allow read: if isOwner(merchantId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // products/{productId}: merchants manage their own drafts, but only
    // Cloud Functions can flip status (createProduct / reviewProduct).
    // Every list query must filter by merchantId or by status == 'approved'
    // so this per-document rule can be satisfied for the whole result set.
    match /products/{productId} {
      allow get: if resource.data.status == 'approved'
        || isOwner(resource.data.merchantId)
        || isAdmin();
      allow list: if resource.data.status == 'approved'
        || isOwner(resource.data.merchantId)
        || isAdmin();
      allow write: if false;
    }

    // payments/{paymentId}: created and mutated only via Cloud Functions
    // (createPaymentLink, submitPayment, checkPaymentStatus, webhook).
    // A payment link's own doc is readable by anyone holding its id (the
    // random doc id itself is the secret), plus the owning merchant/admins.
    match /payments/{paymentId} {
      allow get: if true;
      allow list: if isOwner(resource.data.merchantId) || isAdmin();
      allow write: if false;
    }

    // withdrawals/{withdrawalId}: merchants can read their own requests
    // (query filtered by merchantId), admins can read/list all. All writes
    // go through Cloud Functions so ledger balances stay consistent.
    match /withdrawals/{withdrawalId} {
      allow get: if isOwner(resource.data.merchantId) || isAdmin();
      allow list: if isOwner(resource.data.merchantId) || isAdmin();
      allow write: if false;
    }

    // Internal audit log, server-only.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
